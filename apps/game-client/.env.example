# Client RIW — variables d'environnement Vite.
# Copier en .env.local pour le dev local. NE PAS committer .env.local.
# Seules les vars prefixees VITE_ sont exposees au bundle navigateur :
# ne JAMAIS mettre de secret ici (tout est public cote client).

# URL du serveur Colyseus.
# Dev   : laisser vide -> fallback ws://localhost:2567 (voir NetworkClient.ts)
# Prod  : wss://<app>.fly.dev (TLS obligatoire en prod)
VITE_GAME_SERVER_URL=
