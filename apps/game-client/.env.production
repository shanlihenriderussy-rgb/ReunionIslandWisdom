# Client RIW — env de build PROD (utilise par `vite build`).
# Valeur publique (pas un secret) : URL du serveur Colyseus en prod.
# Adapter le sous-domaine si l'app Fly est renommee.
# Cloudflare Pages peut aussi surcharger via une var de projet du meme nom.
VITE_GAME_SERVER_URL=wss://riw-game-server.fly.dev
