{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reunion Island Wisdom",
  "version": "0.1.0",
  "identifier": "re.uilab.riw",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "corepack pnpm --filter @riw/game-client dev",
    "beforeBuildCommand": "corepack pnpm --filter @riw/game-client build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reunion Island Wisdom",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost wss://riw-game-server.fly.dev https://riw-game-server.fly.dev; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "UI Lab Reunion",
    "category": "Game",
    "shortDescription": "MMORPG 3D explorable situe a La Reunion."
  }
}
