{
  "name": "riw-build-cook",
  "version": "0.1.0",
  "purpose": "Contrat MCP local pour piloter Reunion Island Wisdom comme un programme cook/build/package, style Unreal Engine.",
  "runtime": "local-first",
  "agents": [
    {
      "id": "codex-build-engineer",
      "role": "Patch code, scripts, validations locales, packaging zip.",
      "allowedCommands": [
        "corepack pnpm --filter @riw/game-client typecheck",
        "corepack pnpm --filter @riw/game-client lint",
        "corepack pnpm --filter @riw/game-client build",
        "corepack pnpm cook:web",
        "corepack pnpm package:web",
        "corepack pnpm cook:desktop",
        "corepack pnpm launch:web",
        "corepack pnpm launch:desktop",
        "corepack pnpm stop:web"
      ]
    },
    {
      "id": "claude-design-producer",
      "role": "Structurer docs, direction produit, backlog, decisions et syntheses publiques.",
      "allowedWriteScopes": [
        "docs/obsidian",
        "docs/world"
      ]
    }
  ],
  "phases": [
    { "id": "validate", "command": "corepack pnpm --filter @riw/game-client typecheck && corepack pnpm --filter @riw/game-client lint" },
    { "id": "cook-web", "command": "corepack pnpm cook:web" },
    { "id": "package-web", "command": "corepack pnpm package:web" },
    { "id": "cook-desktop", "command": "corepack pnpm cook:desktop", "requires": ["rust"], "platform": "windows", "fallback": "cargo build --release si le binding natif Tauri JS est bloque par Windows Application Control" },
    { "id": "launch-web", "command": "corepack pnpm launch:web", "platform": "windows" },
    { "id": "launch-desktop", "command": "corepack pnpm launch:desktop", "platform": "windows" }
  ],
  "securityRules": [
    "Pas de secret cote client.",
    "Pas de dataset brut lourd dans le zip.",
    "Pas de logique serveur autoritative dans le client.",
    "Notes Obsidian obligatoires pour decision, pipeline et release."
  ],
  "artifacts": {
    "webZip": "output/reunion-island-wisdom-web-<version>-<timestamp>.zip",
    "clientDist": "apps/game-client/dist",
    "publicManifest": "apps/game-client/public/manifest.webmanifest",
    "desktopInstaller": "apps/game-client/src-tauri/target/release/bundle/{msi,nsis}/Reunion Island Wisdom_<version>_x64*.{msi,exe}",
    "desktopExe": "apps/game-client/src-tauri/target/release/riw.exe"
  }
}
