{
  "name": "reunion-island-wisdom",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @riw/game-client --filter @riw/game-server dev",
    "dev:client": "corepack pnpm --filter @riw/game-client dev",
    "dev:server": "corepack pnpm --filter @riw/game-server dev",
    "terrain:dem": "node tools/build-lareunion-dem-terrain.mjs",
    "terrain:stl": "node tools/build-lareunion-relief-map.mjs",
    "build": "corepack pnpm -r build",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "cook:web": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package-web-release.ps1",
    "package:web": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package-web-release.ps1 -SkipBuild",
    "release:web": "corepack pnpm --filter @riw/game-client typecheck && corepack pnpm --filter @riw/game-client lint && powershell -NoProfile -ExecutionPolicy Bypass -File tools/package-web-release.ps1",
    "launch:web": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/launch-game.ps1",
    "launch:web:no-browser": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/launch-game.ps1 -NoBrowser",
    "stop:web": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/stop-game.ps1",
    "launch:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/launch-desktop.ps1",
    "release:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-desktop-release.ps1",
    "desktop:dev": "corepack pnpm --filter @riw/game-client tauri:dev",
    "cook:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-desktop-release.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  }
}
